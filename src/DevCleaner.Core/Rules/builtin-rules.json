    "paths": [ "{localappdata}\\JetBrains\\Rider*\\resharper-host\\local\\Transient", "~/.cache/JetBrains/Rider*/resharper-host/local/Transient", "~/Library/Caches/JetBrains/Rider*/resharper-host/local/Transient" ] },
  { "id": "resharper-caches", "name": "ReSharper & dotPeek caches", "category": "Ide", "risk": "Safe", "os": [ "Windows" ], "processes": [ "devenv", "rider64", "dotPeek64", "dotPeek32" ], "contentsOnly": true,
    "paths": [ "{localappdata}\\JetBrains\\Transient", "{localappdata}\\JetBrains\\Shared\\vAny\\Cache", "{localappdata}\\JetBrains\\Shared\\vAny\\DecompilerCache" ] },
  { "id": "jetbrains-installer-packages", "name": "JetBrains .NET tools installer packages", "category": "Ide", "risk": "Review", "os": [ "Windows" ], "contentsOnly": true,
    "paths": [ "{localappdata}\\JetBrains\\Installations\\Packages" ], "note": "Re-downloaded when ReSharper/dotUltimate is updated or repaired" },
  { "id": "jetbrains-toolbox", "name": "JetBrains Toolbox downloads & logs", "category": "Ide", "risk": "Safe", "processes": [ "jetbrains-toolbox" ], "contentsOnly": true,
    "paths": [ "{localappdata}\\JetBrains\\Toolbox\\download", "{localappdata}\\JetBrains\\Toolbox\\logs", "~/.local/share/JetBrains/Toolbox/download", "~/.local/share/JetBrains/Toolbox/logs",
               "~/Library/Application Support/JetBrains/Toolbox/download" ] },
  { "id": "jetbrains-remote-dev", "name": "JetBrains Gateway remote IDE backends", "category": "Ide", "risk": "Review", "os": [ "Linux" ], "contentsOnly": true,
    "paths": [ "~/.cache/JetBrains/RemoteDev/dist" ], "note": "Gateway re-downloads the backend on next connect" },
  { "id": "visual-studio-cache", "name": "Visual Studio component cache", "category": "Ide", "risk": "Safe", "os": [ "Windows" ], "processes": [ "devenv" ], "contentsOnly": true,
    "paths": [ "{localappdata}\\Microsoft\\VisualStudio\\*\\ComponentModelCache" ] },
  { "id": "vscode-cache", "name": "VS Code caches & logs", "category": "Ide", "risk": "Safe", "processes": [ "Code" ], "contentsOnly": true,
    "paths": [ "{appdata}\\Code\\Cache", "{appdata}\\Code\\CachedData", "{appdata}\\Code\\CachedExtensionVSIXs", "{appdata}\\Code\\Code Cache", "{appdata}\\Code\\GPUCache", "{appdata}\\Code\\logs",
