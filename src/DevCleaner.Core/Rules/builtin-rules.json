    "paths": [ "{localappdata}\\JetBrains\\*\\caches", "{localappdata}\\JetBrains\\*\\log", "{localappdata}\\JetBrains\\*\\tmp", "{localappdata}\\JetBrains\\*\\jcef_cache",
               "~/.cache/JetBrains/*/caches", "~/.cache/JetBrains/*/log", "~/.cache/JetBrains/*/tmp", "~/.cache/JetBrains/*/jcef_cache",
               "~/Library/Caches/JetBrains/*/caches", "~/Library/Caches/JetBrains/*/tmp", "~/Library/Caches/JetBrains/*/jcef_cache", "~/Library/Logs/JetBrains" ] },
  { "id": "jetbrains-index", "name": "JetBrains IDE indexes & build caches", "category": "Ide", "risk": "Review", "contentsOnly": true,
    "processes": [ "rider64", "idea64", "webstorm64", "pycharm64", "clion64", "goland64", "datagrip64", "phpstorm64", "rubymine64", "rustrover64", "dataspell64", "aqua64", "writerside64", "rider", "idea" ],
    "paths": [ "{localappdata}\\JetBrains\\*\\index", "{localappdata}\\JetBrains\\*\\compile-server", "~/.cache/JetBrains/*/index", "~/.cache/JetBrains/*/compile-server",
