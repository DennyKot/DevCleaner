  { "id": "vscode-insiders-cache", "name": "VS Code Insiders caches & logs", "category": "Ide", "risk": "Safe", "processes": [ "Code - Insiders" ], "contentsOnly": true,
    "paths": [ "{appdata}\\Code - Insiders\\Cache", "{appdata}\\Code - Insiders\\CachedData", "{appdata}\\Code - Insiders\\CachedExtensionVSIXs", "{appdata}\\Code - Insiders\\Code Cache", "{appdata}\\Code - Insiders\\GPUCache", "{appdata}\\Code - Insiders\\logs",
               "~/.config/Code - Insiders/Cache", "~/.config/Code - Insiders/CachedData", "~/.config/Code - Insiders/logs", "~/Library/Application Support/Code - Insiders/Cache", "~/Library/Application Support/Code - Insiders/CachedData" ] },
  { "id": "cursor-cache", "name": "Cursor caches & logs", "category": "Ide", "risk": "Safe", "processes": [ "Cursor" ], "contentsOnly": true,
    "paths": [ "{appdata}\\Cursor\\Cache", "{appdata}\\Cursor\\CachedData", "{appdata}\\Cursor\\CachedExtensionVSIXs", "{appdata}\\Cursor\\Code Cache", "{appdata}\\Cursor\\GPUCache", "{appdata}\\Cursor\\logs",
               "~/.config/Cursor/Cache", "~/.config/Cursor/CachedData", "~/.config/Cursor/logs", "~/Library/Application Support/Cursor/Cache", "~/Library/Application Support/Cursor/CachedData" ] },
  { "id": "xcode-derived-data", "name": "Xcode DerivedData", "category": "Ide", "risk": "Safe", "os": [ "MacOS" ], "processes": [ "Xcode" ], "contentsOnly": true,
    "paths": [ "~/Library/Developer/Xcode/DerivedData" ] },
  { "id": "xcode-cache", "name": "Xcode cache", "category": "Ide", "risk": "Safe", "os": [ "MacOS" ], "processes": [ "Xcode" ], "contentsOnly": true,
    "paths": [ "~/Library/Caches/com.apple.dt.Xcode" ] },
  { "id": "xcode-archives", "name": "Xcode archives", "category": "Ide", "risk": "Caution", "os": [ "MacOS" ], "processes": [ "Xcode" ], "contentsOnly": true,
    "paths": [ "~/Library/Developer/Xcode/Archives" ], "note": "Needed to symbolicate crash reports of shipped builds" },
  { "id": "xcode-device-support", "name": "Xcode device support files", "category": "Ide", "risk": "Review", "os": [ "MacOS" ], "processes": [ "Xcode" ], "contentsOnly": true,
    "paths": [ "~/Library/Developer/Xcode/iOS DeviceSupport", "~/Library/Developer/Xcode/watchOS DeviceSupport" ], "note": "Re-created when a device is connected" },
  { "id": "ios-simulator-caches", "name": "iOS Simulator caches", "category": "Ide", "risk": "Safe", "os": [ "MacOS" ], "processes": [ "Simulator" ], "contentsOnly": true,
    "paths": [ "~/Library/Developer/CoreSimulator/Caches" ] },
  { "id": "android-studio-caches", "name": "Android Studio caches & logs", "category": "Ide", "risk": "Safe", "processes": [ "studio64", "studio" ], "contentsOnly": true,
    "paths": [ "{localappdata}\\Google\\AndroidStudio*\\caches", "{localappdata}\\Google\\AndroidStudio*\\log", "~/.cache/Google/AndroidStudio*/caches", "~/Library/Caches/Google/AndroidStudio*/caches" ] },
  { "id": "android-sdk-cache", "name": "Android SDK & build caches", "category": "Ide", "risk": "Safe", "contentsOnly": true,
    "paths": [ "~/.android/cache", "~/.android/build-cache" ] },
  { "id": "android-emulator-snapshots", "name": "Android emulator snapshots", "category": "Ide", "risk": "Review", "contentsOnly": true,
    "processes": [ "emulator", "qemu-system-x86_64", "qemu-system-aarch64" ], "paths": [ "~/.android/avd/*.avd/snapshots" ], "note": "Emulators will cold boot next time" },
  { "id": "unity-cache", "name": "Unity global package cache", "category": "Ide", "risk": "Safe", "processes": [ "Unity", "Unity Hub" ], "contentsOnly": true,
    "paths": [ "{localappdata}\\Unity\\cache", "~/.cache/unity3d", "~/Library/Unity/cache" ] },
  { "id": "unity-gi-cache", "name": "Unity GI cache", "category": "Ide", "risk": "Safe", "processes": [ "Unity" ], "contentsOnly": true,
    "paths": [ "{localappdata}\\Unity\\Caches\\GiCache", "~/Library/Caches/com.unity3d.UnityEditor/GiCache" ], "note": "Lighting data is recomputed on demand" },
  { "id": "unity-asset-store", "name": "Unity Asset Store downloads", "category": "Ide", "risk": "Review", "processes": [ "Unity", "Unity Hub" ], "contentsOnly": true,
    "paths": [ "{appdata}\\Unity\\Asset Store-5.x", "~/Library/Unity/Asset Store-5.x", "~/.local/share/unity3d/Asset Store-5.x" ], "note": "Re-download from the Package Manager (My Assets)" },

