[
  // ---------- System temp & logs ----------
  { "id": "user-temp", "name": "User temp folder", "category": "SystemTemp", "risk": "Safe", "paths": [ "{temp}" ], "contentsOnly": true },
  { "id": "windows-temp", "name": "Windows temp folder", "category": "SystemTemp", "risk": "Review", "os": [ "Windows" ], "paths": [ "%SystemRoot%\\Temp" ], "contentsOnly": true, "note": "Requires administrator rights" },
  { "id": "windows-update-cache", "name": "Windows Update download cache", "category": "SystemTemp", "risk": "Caution", "os": [ "Windows" ], "paths": [ "%SystemRoot%\\SoftwareDistribution\\Download" ], "contentsOnly": true, "note": "Requires administrator rights" },
  { "id": "thumbnail-cache", "name": "Explorer thumbnail cache", "category": "SystemTemp", "risk": "Review", "os": [ "Windows" ], "paths": [ "{localappdata}\\Microsoft\\Windows\\Explorer\\thumbcache_*.db" ] },
  { "id": "directx-shader-cache", "name": "DirectX shader cache", "category": "SystemTemp", "risk": "Safe", "os": [ "Windows" ], "paths": [ "{localappdata}\\D3DSCache" ], "contentsOnly": true },
  { "id": "crash-dumps", "name": "Crash dumps", "category": "Logs", "risk": "Safe", "os": [ "Windows" ], "paths": [ "{localappdata}\\CrashDumps" ], "contentsOnly": true },
  { "id": "wer-reports", "name": "Windows Error Reporting", "category": "Logs", "risk": "Safe", "os": [ "Windows" ], "paths": [ "{localappdata}\\Microsoft\\Windows\\WER", "%ProgramData%\\Microsoft\\Windows\\WER\\ReportArchive", "%ProgramData%\\Microsoft\\Windows\\WER\\ReportQueue" ], "contentsOnly": true },
  { "id": "unix-user-cache-logs", "name": "User logs", "category": "Logs", "risk": "Review", "os": [ "MacOS" ], "paths": [ "~/Library/Logs" ], "contentsOnly": true },
  { "id": "windows-memory-dumps", "name": "Windows memory & kernel dumps", "category": "Logs", "risk": "Review", "os": [ "Windows" ], "contentsOnly": true,
    "paths": [ "%SystemRoot%\\MEMORY.DMP", "%SystemRoot%\\Minidump", "%SystemRoot%\\LiveKernelReports" ], "note": "Requires administrator rights" },
  { "id": "linux-thumbnails", "name": "Thumbnail cache", "category": "SystemTemp", "risk": "Safe", "os": [ "Linux" ], "paths": [ "~/.cache/thumbnails" ], "contentsOnly": true },

  // ---------- Browsers (cache only, never profile data) ----------
  { "id": "chrome-cache", "name": "Google Chrome cache", "category": "Browsers", "risk": "Safe", "note": "Cache only: cookies, passwords and sessions are untouched (no logouts)", "os": [ "Windows" ], "processes": [ "chrome" ], "contentsOnly": true,
    "paths": [ "{localappdata}\\Google\\Chrome\\User Data\\*\\Cache", "{localappdata}\\Google\\Chrome\\User Data\\*\\Code Cache", "{localappdata}\\Google\\Chrome\\User Data\\*\\GPUCache", "{localappdata}\\Google\\Chrome\\User Data\\ShaderCache", "{localappdata}\\Google\\Chrome\\User Data\\GrShaderCache" ] },
  { "id": "edge-cache", "name": "Microsoft Edge cache", "category": "Browsers", "risk": "Safe", "note": "Cache only: cookies, passwords and sessions are untouched (no logouts)", "os": [ "Windows" ], "processes": [ "msedge" ], "contentsOnly": true,
    "paths": [ "{localappdata}\\Microsoft\\Edge\\User Data\\*\\Cache", "{localappdata}\\Microsoft\\Edge\\User Data\\*\\Code Cache", "{localappdata}\\Microsoft\\Edge\\User Data\\*\\GPUCache", "{localappdata}\\Microsoft\\Edge\\User Data\\ShaderCache", "{localappdata}\\Microsoft\\Edge\\User Data\\GrShaderCache" ] },
  { "id": "brave-cache", "name": "Brave cache", "category": "Browsers", "risk": "Safe", "note": "Cache only: cookies, passwords and sessions are untouched (no logouts)", "os": [ "Windows" ], "processes": [ "brave" ], "contentsOnly": true,
    "paths": [ "{localappdata}\\BraveSoftware\\Brave-Browser\\User Data\\*\\Cache", "{localappdata}\\BraveSoftware\\Brave-Browser\\User Data\\*\\Code Cache", "{localappdata}\\BraveSoftware\\Brave-Browser\\User Data\\*\\GPUCache" ] },
  { "id": "opera-cache", "name": "Opera cache", "category": "Browsers", "risk": "Safe", "note": "Cache only: cookies, passwords and sessions are untouched (no logouts)", "os": [ "Windows" ], "processes": [ "opera" ], "contentsOnly": true,
    "paths": [ "{localappdata}\\Opera Software\\*\\Cache" ] },
  { "id": "firefox-cache", "name": "Firefox cache", "category": "Browsers", "risk": "Safe", "note": "Cache only: cookies, passwords and sessions are untouched (no logouts)", "processes": [ "firefox" ], "contentsOnly": true,
    "paths": [ "{localappdata}\\Mozilla\\Firefox\\Profiles\\*\\cache2", "~/.cache/mozilla/firefox/*/cache2", "~/Library/Caches/Firefox/Profiles/*/cache2" ] },
  { "id": "chrome-cache-unix", "name": "Google Chrome cache", "category": "Browsers", "risk": "Safe", "note": "Cache only: cookies, passwords and sessions are untouched (no logouts)", "os": [ "Linux", "MacOS" ], "processes": [ "chrome", "Google Chrome" ], "contentsOnly": true,
    "paths": [ "~/.cache/google-chrome/*/Cache", "~/.cache/google-chrome/*/Code Cache", "~/Library/Caches/Google/Chrome/*/Cache" ] },
  { "id": "inet-cache", "name": "Windows internet cache (WebView/IE)", "category": "Browsers", "risk": "Safe", "note": "Cache only: cookies, passwords and sessions are untouched (no logouts)", "os": [ "Windows" ], "contentsOnly": true,
