[
  // ---------- System temp & logs ----------
  { "id": "user-temp", "name": "User temp folder", "category": "SystemTemp", "risk": "Safe", "paths": [ "{temp}" ], "contentsOnly": true },
  { "id": "windows-temp", "name": "Windows temp folder", "category": "SystemTemp", "risk": "Review", "os": [ "Windows" ], "paths": [ "%SystemRoot%\\Temp" ], "contentsOnly": true, "note": "Requires administrator rights" },
  { "id": "windows-update-cache", "name": "Windows Update download cache", "category": "SystemTemp", "risk": "Caution", "os": [ "Windows" ], "paths": [ "%SystemRoot%\\SoftwareDistribution\\Download" ], "contentsOnly": true, "note": "Requires administrator rights" },
  { "id": "thumbnail-cache", "name": "Explorer thumbnail cache", "category": "SystemTemp", "risk": "Review", "os": [ "Windows" ], "paths": [ "{localappdata}\\Microsoft\\Windows\\Explorer\\thumbcache_*.db" ] },
  { "id": "directx-shader-cache", "name": "DirectX shader cache", "category": "SystemTemp", "risk": "Safe", "os": [ "Windows" ], "paths": [ "{localappdata}\\D3DSCache" ], "contentsOnly": true },
  { "id": "crash-dumps", "name": "Crash dumps", "category": "Logs", "risk": "Safe", "os": [ "Windows" ], "paths": [ "{localappdata}\\CrashDumps" ], "contentsOnly": true },
  { "id": "wer-reports", "name": "Windows Error Reporting", "category": "Logs", "risk": "Safe", "os": [ "Windows" ], "paths": [ "{localappdata}\\Microsoft\\Windows\\WER", "%ProgramData%\\Microsoft\\Windows\\WER\\ReportArchive", "%ProgramData%\\Microsoft\\Windows\\WER\\ReportQueue" ], "contentsOnly": true },
  { "id": "unix-user-cache-logs", "name": "User logs", "category": "Logs", "risk": "Review", "os": [ "MacOS" ], "paths": [ "~/Library/Logs" ], "contentsOnly": true },

  // ---------- Browsers (cache only, never profile data) ----------
  { "id": "chrome-cache", "name": "Google Chrome cache", "category": "Browsers", "risk": "Safe", "os": [ "Windows" ], "processes": [ "chrome" ], "contentsOnly": true,
    "paths": [ "{localappdata}\\Google\\Chrome\\User Data\\*\\Cache", "{localappdata}\\Google\\Chrome\\User Data\\*\\Code Cache", "{localappdata}\\Google\\Chrome\\User Data\\*\\GPUCache", "{localappdata}\\Google\\Chrome\\User Data\\ShaderCache", "{localappdata}\\Google\\Chrome\\User Data\\GrShaderCache" ] },
  { "id": "edge-cache", "name": "Microsoft Edge cache", "category": "Browsers", "risk": "Safe", "os": [ "Windows" ], "processes": [ "msedge" ], "contentsOnly": true,
    "paths": [ "{localappdata}\\Microsoft\\Edge\\User Data\\*\\Cache", "{localappdata}\\Microsoft\\Edge\\User Data\\*\\Code Cache", "{localappdata}\\Microsoft\\Edge\\User Data\\*\\GPUCache", "{localappdata}\\Microsoft\\Edge\\User Data\\ShaderCache", "{localappdata}\\Microsoft\\Edge\\User Data\\GrShaderCache" ] },
  { "id": "brave-cache", "name": "Brave cache", "category": "Browsers", "risk": "Safe", "os": [ "Windows" ], "processes": [ "brave" ], "contentsOnly": true,
    "paths": [ "{localappdata}\\BraveSoftware\\Brave-Browser\\User Data\\*\\Cache", "{localappdata}\\BraveSoftware\\Brave-Browser\\User Data\\*\\Code Cache", "{localappdata}\\BraveSoftware\\Brave-Browser\\User Data\\*\\GPUCache" ] },
  { "id": "opera-cache", "name": "Opera cache", "category": "Browsers", "risk": "Safe", "os": [ "Windows" ], "processes": [ "opera" ], "contentsOnly": true,
    "paths": [ "{localappdata}\\Opera Software\\*\\Cache" ] },
  { "id": "firefox-cache", "name": "Firefox cache", "category": "Browsers", "risk": "Safe", "processes": [ "firefox" ], "contentsOnly": true,
    "paths": [ "{localappdata}\\Mozilla\\Firefox\\Profiles\\*\\cache2", "~/.cache/mozilla/firefox/*/cache2", "~/Library/Caches/Firefox/Profiles/*/cache2" ] },
  { "id": "chrome-cache-unix", "name": "Google Chrome cache", "category": "Browsers", "risk": "Safe", "os": [ "Linux", "MacOS" ], "processes": [ "chrome", "Google Chrome" ], "contentsOnly": true,
    "paths": [ "~/.cache/google-chrome/*/Cache", "~/.cache/google-chrome/*/Code Cache", "~/Library/Caches/Google/Chrome/*/Cache" ] },

  // ---------- IDEs ----------
  { "id": "jetbrains-caches", "name": "JetBrains IDE caches & logs", "category": "Ide", "risk": "Safe", "contentsOnly": true,
    "processes": [ "rider64", "idea64", "webstorm64", "pycharm64", "clion64", "goland64", "datagrip64", "phpstorm64", "rubymine64", "rider", "idea" ],
    "paths": [ "{localappdata}\\JetBrains\\*\\caches", "{localappdata}\\JetBrains\\*\\log", "~/.cache/JetBrains/*/caches", "~/Library/Caches/JetBrains/*/caches" ] },
  { "id": "visual-studio-cache", "name": "Visual Studio component cache", "category": "Ide", "risk": "Safe", "os": [ "Windows" ], "processes": [ "devenv" ], "contentsOnly": true,
    "paths": [ "{localappdata}\\Microsoft\\VisualStudio\\*\\ComponentModelCache" ] },
  { "id": "vscode-cache", "name": "VS Code caches & logs", "category": "Ide", "risk": "Safe", "processes": [ "Code" ], "contentsOnly": true,
    "paths": [ "{appdata}\\Code\\Cache", "{appdata}\\Code\\CachedData", "{appdata}\\Code\\CachedExtensionVSIXs", "{appdata}\\Code\\Code Cache", "{appdata}\\Code\\GPUCache", "{appdata}\\Code\\logs",
               "~/.config/Code/Cache", "~/.config/Code/CachedData", "~/.config/Code/logs", "~/Library/Application Support/Code/Cache", "~/Library/Application Support/Code/CachedData" ] },
  { "id": "xcode-derived-data", "name": "Xcode DerivedData", "category": "Ide", "risk": "Safe", "os": [ "MacOS" ], "processes": [ "Xcode" ], "contentsOnly": true,
    "paths": [ "~/Library/Developer/Xcode/DerivedData" ] },
  { "id": "xcode-device-support", "name": "Xcode device support files", "category": "Ide", "risk": "Review", "os": [ "MacOS" ], "processes": [ "Xcode" ], "contentsOnly": true,
    "paths": [ "~/Library/Developer/Xcode/iOS DeviceSupport", "~/Library/Developer/Xcode/watchOS DeviceSupport" ], "note": "Re-created when a device is connected" },
  { "id": "ios-simulator-caches", "name": "iOS Simulator caches", "category": "Ide", "risk": "Safe", "os": [ "MacOS" ], "processes": [ "Simulator" ], "contentsOnly": true,
    "paths": [ "~/Library/Developer/CoreSimulator/Caches" ] },
  { "id": "android-studio-caches", "name": "Android Studio caches & logs", "category": "Ide", "risk": "Safe", "processes": [ "studio64", "studio" ], "contentsOnly": true,
    "paths": [ "{localappdata}\\Google\\AndroidStudio*\\caches", "{localappdata}\\Google\\AndroidStudio*\\log", "~/.cache/Google/AndroidStudio*/caches", "~/Library/Caches/Google/AndroidStudio*/caches" ] },
  { "id": "android-sdk-cache", "name": "Android SDK & build caches", "category": "Ide", "risk": "Safe", "contentsOnly": true,
    "paths": [ "~/.android/cache", "~/.android/build-cache" ] },
  { "id": "android-emulator-snapshots", "name": "Android emulator snapshots", "category": "Ide", "risk": "Review", "contentsOnly": true,
    "processes": [ "emulator", "qemu-system-x86_64", "qemu-system-aarch64" ], "paths": [ "~/.android/avd/*.avd/snapshots" ], "note": "Emulators will cold boot next time" },

  // ---------- Package caches ----------
  { "id": "nuget-packages", "name": "NuGet global packages", "category": "PackageCaches", "risk": "Review", "paths": [ "{nugetpackages}" ], "contentsOnly": true, "note": "Packages will be re-downloaded on next restore" },
  { "id": "nuget-http-cache", "name": "NuGet HTTP & plugins cache", "category": "PackageCaches", "risk": "Safe", "contentsOnly": true,
    "paths": [ "{localappdata}\\NuGet\\v3-cache", "{localappdata}\\NuGet\\plugins-cache", "~/.local/share/NuGet/http-cache", "~/.local/share/NuGet/v3-cache" ] },
  { "id": "npm-cache", "name": "npm cache", "category": "PackageCaches", "risk": "Safe", "contentsOnly": true, "paths": [ "{localappdata}\\npm-cache", "~/.npm/_cacache" ] },
  { "id": "yarn-cache", "name": "Yarn cache", "category": "PackageCaches", "risk": "Safe", "contentsOnly": true, "paths": [ "{localappdata}\\Yarn\\Cache", "~/.cache/yarn", "~/Library/Caches/Yarn" ] },
  { "id": "pnpm-store", "name": "pnpm store", "category": "PackageCaches", "risk": "Review", "contentsOnly": true, "paths": [ "{localappdata}\\pnpm\\store", "~/.local/share/pnpm/store", "~/Library/pnpm/store" ] },
  { "id": "pip-cache", "name": "pip cache", "category": "PackageCaches", "risk": "Safe", "contentsOnly": true, "paths": [ "{localappdata}\\pip\\Cache", "~/.cache/pip", "~/Library/Caches/pip" ] },
  { "id": "gradle-cache", "name": "Gradle caches", "category": "PackageCaches", "risk": "Review", "contentsOnly": true, "paths": [ "~/.gradle/caches" ] },
  { "id": "maven-repo", "name": "Maven local repository", "category": "PackageCaches", "risk": "Review", "contentsOnly": true, "paths": [ "~/.m2/repository" ] },
  { "id": "cargo-cache", "name": "Cargo registry cache", "category": "PackageCaches", "risk": "Safe", "contentsOnly": true, "paths": [ "~/.cargo/registry/cache" ] },
  { "id": "dotnet-tool-resolver-cache", "name": ".NET tool resolver cache", "category": "PackageCaches", "risk": "Safe", "contentsOnly": true, "paths": [ "~/.dotnet/toolResolverCache" ] },
  { "id": "playwright-browsers", "name": "Playwright browsers", "category": "PackageCaches", "risk": "Review", "contentsOnly": true,
    "paths": [ "{localappdata}\\ms-playwright", "~/.cache/ms-playwright", "~/Library/Caches/ms-playwright" ], "note": "Reinstall with npx playwright install" },
  { "id": "cypress-cache", "name": "Cypress binary cache", "category": "PackageCaches", "risk": "Review", "contentsOnly": true, "processes": [ "Cypress" ],
    "paths": [ "{localappdata}\\Cypress\\Cache", "~/.cache/Cypress", "~/Library/Caches/Cypress" ], "note": "Reinstall with npx cypress install" },
  { "id": "winget-cache", "name": "WinGet downloads & logs", "category": "PackageCaches", "risk": "Safe", "os": [ "Windows" ], "processes": [ "winget" ], "contentsOnly": true,
    "paths": [ "{temp}\\WinGet", "{localappdata}\\Packages\\Microsoft.DesktopAppInstaller_8wekyb3d8bbwe\\LocalState\\DiagOutputDir", "{localappdata}\\Microsoft\\WinGet\\Logs" ] },
  { "id": "homebrew-cache", "name": "Homebrew downloads & logs", "category": "PackageCaches", "risk": "Safe", "os": [ "MacOS", "Linux" ], "processes": [ "brew" ], "contentsOnly": true,
    "paths": [ "~/Library/Caches/Homebrew", "~/Library/Logs/Homebrew", "~/.cache/Homebrew" ], "note": "Old installers only; installed formulae are untouched" },
  { "id": "bun-cache", "name": "Bun install cache", "category": "PackageCaches", "risk": "Safe", "contentsOnly": true, "paths": [ "~/.bun/install/cache" ] },
  { "id": "deno-cache", "name": "Deno cache", "category": "PackageCaches", "risk": "Safe", "contentsOnly": true, "paths": [ "{localappdata}\\deno", "~/.cache/deno", "~/Library/Caches/deno" ] },
  { "id": "node-gyp-cache", "name": "node-gyp headers cache", "category": "PackageCaches", "risk": "Safe", "contentsOnly": true, "paths": [ "{localappdata}\\node-gyp\\Cache", "~/.cache/node-gyp", "~/Library/Caches/node-gyp" ] },
  { "id": "electron-cache", "name": "Electron download cache", "category": "PackageCaches", "risk": "Safe", "contentsOnly": true, "paths": [ "{localappdata}\\electron\\Cache", "~/.cache/electron", "~/Library/Caches/electron" ] },
  { "id": "poetry-cache", "name": "Poetry cache", "category": "PackageCaches", "risk": "Safe", "contentsOnly": true, "paths": [ "{localappdata}\\pypoetry\\Cache", "~/.cache/pypoetry", "~/Library/Caches/pypoetry" ] },
  { "id": "uv-cache", "name": "uv cache", "category": "PackageCaches", "risk": "Safe", "contentsOnly": true, "processes": [ "uv" ], "paths": [ "{localappdata}\\uv\\cache", "~/.cache/uv" ] },
  { "id": "composer-cache", "name": "Composer cache", "category": "PackageCaches", "risk": "Safe", "contentsOnly": true, "paths": [ "{localappdata}\\Composer", "~/.cache/composer", "~/Library/Caches/composer" ] },
  { "id": "cargo-git-checkouts", "name": "Cargo git checkouts", "category": "PackageCaches", "risk": "Safe", "contentsOnly": true, "paths": [ "~/.cargo/git/checkouts" ] },
  { "id": "cocoapods-cache", "name": "CocoaPods cache", "category": "PackageCaches", "risk": "Safe", "os": [ "MacOS" ], "contentsOnly": true, "paths": [ "~/Library/Caches/CocoaPods" ] },
  { "id": "go-build-cache", "name": "Go build cache", "category": "PackageCaches", "risk": "Safe", "contentsOnly": true, "paths": [ "{localappdata}\\go-build", "~/.cache/go-build", "~/Library/Caches/go-build" ] },

  // ---------- Project artefacts (folders next to marker files) ----------
  { "id": "dotnet-build", "name": ".NET build output", "category": "DotNetProjects", "risk": "Safe", "markers": [ "*.csproj", "*.fsproj", "*.vbproj", "*.sqlproj" ], "targets": [ "bin", "obj" ] },
  { "id": "dotnet-vs-folder", "name": "Visual Studio .vs folder", "category": "DotNetProjects", "risk": "Review", "markers": [ "*.sln", "*.slnx" ], "targets": [ ".vs" ], "processes": [ "devenv" ], "note": "Contains per-user IDE state" },
  { "id": "node-modules", "name": "node_modules", "category": "NodeProjects", "risk": "Review", "markers": [ "package.json" ], "targets": [ "node_modules" ], "note": "Restore with npm/yarn/pnpm install" },
  { "id": "node-build-cache", "name": "JS framework build caches", "category": "NodeProjects", "risk": "Safe", "markers": [ "package.json" ], "targets": [ ".next", ".nuxt", ".turbo", ".parcel-cache", ".svelte-kit", ".angular" ] },
  { "id": "rust-target", "name": "Rust target", "category": "OtherProjects", "risk": "Safe", "markers": [ "Cargo.toml" ], "targets": [ "target" ] },
  { "id": "python-caches", "name": "Python caches", "category": "OtherProjects", "risk": "Safe", "markers": [ "pyproject.toml", "requirements.txt", "setup.py" ], "targets": [ "__pycache__", ".pytest_cache", ".mypy_cache", ".ruff_cache", ".tox" ] },
  { "id": "python-venv", "name": "Python virtual env", "category": "OtherProjects", "risk": "Review", "markers": [ "pyproject.toml", "requirements.txt", "setup.py" ], "targets": [ ".venv", "venv" ] },
  { "id": "gradle-build", "name": "Gradle build output", "category": "OtherProjects", "risk": "Safe", "markers": [ "build.gradle", "build.gradle.kts", "settings.gradle", "settings.gradle.kts" ], "targets": [ "build", ".gradle" ] },
  { "id": "maven-target", "name": "Maven target", "category": "OtherProjects", "risk": "Safe", "markers": [ "pom.xml" ], "targets": [ "target" ] },
  { "id": "unity-library", "name": "Unity Library & Temp", "category": "OtherProjects", "risk": "Review", "markers": [ "ProjectSettings/ProjectVersion.txt" ], "targets": [ "Library", "Temp" ], "processes": [ "Unity" ], "note": "Unity re-imports all assets on next open" },
  { "id": "unreal-intermediate", "name": "Unreal Intermediate & DDC", "category": "OtherProjects", "risk": "Safe", "markers": [ "*.uproject" ], "targets": [ "Intermediate", "DerivedDataCache" ], "processes": [ "UnrealEditor", "UE4Editor" ] },
  { "id": "terraform-dir", "name": "Terraform .terraform", "category": "OtherProjects", "risk": "Review", "markers": [ "*.tf" ], "targets": [ ".terraform" ], "note": "Run terraform init again" },
  { "id": "flutter-build", "name": "Dart/Flutter build output", "category": "OtherProjects", "risk": "Safe", "markers": [ "pubspec.yaml" ], "targets": [ ".dart_tool", "build" ] },
  { "id": "swift-build", "name": "SwiftPM .build", "category": "OtherProjects", "risk": "Safe", "markers": [ "Package.swift" ], "targets": [ ".build" ] },
  { "id": "elixir-build", "name": "Elixir _build & deps", "category": "OtherProjects", "risk": "Safe", "markers": [ "mix.exs" ], "targets": [ "_build", "deps" ] },
  { "id": "zig-cache", "name": "Zig cache", "category": "OtherProjects", "risk": "Safe", "markers": [ "build.zig" ], "targets": [ ".zig-cache", "zig-cache", "zig-out" ] },
  { "id": "haskell-stack-work", "name": "Haskell .stack-work", "category": "OtherProjects", "risk": "Safe", "markers": [ "stack.yaml" ], "targets": [ ".stack-work" ] }
]
